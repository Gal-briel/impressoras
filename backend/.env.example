SECRET_KEY=troque-esta-chave-em-producao
JWT_SECRET_KEY=troque-esta-chave-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=postgresql+asyncpg://usuario:senha@host:5432/database
SYNC_DATABASE_URL=postgresql://usuario:senha@host:5432/database

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
REDIS_URL=redis://localhost:6379/0

ENVIRONMENT=development

# CORS
# Separe múltiplas origens por vírgula.
# Em produção, nunca use "*".
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# Rate limit
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REFRESH_MAX_ATTEMPTS=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=300
RATE_LIMIT_ENROLLMENT_MAX_ATTEMPTS=5
RATE_LIMIT_ENROLLMENT_WINDOW_SECONDS=600

# Agent update packages
# Hosts permitidos para package_url do comando update_agent.
AGENT_PACKAGE_ALLOWED_HOSTS=riverbank-class-licorice.ngrok-free.dev,localhost,127.0.0.1
