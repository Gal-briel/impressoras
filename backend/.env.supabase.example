# Exemplo seguro para rodar o PrinterBridge usando Supabase/PostgreSQL.
# Nunca commitar senha real.

SUPABASE_PROJECT_REF=seu-project-ref
SUPABASE_DB_PASSWORD=sua-senha-url-encoded

# URL síncrona usada por rotas legadas com psycopg2.
SYNC_DATABASE_URL=postgresql://postgres.${SUPABASE_PROJECT_REF}:${SUPABASE_DB_PASSWORD}@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# URL assíncrona usada pelo SQLAlchemy/asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres.${SUPABASE_PROJECT_REF}:${SUPABASE_DB_PASSWORD}@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

OPERATIONAL_ALERTS_OFFLINE_SYNC_ENABLED=true
OPERATIONAL_ALERTS_OFFLINE_SYNC_INTERVAL_SECONDS=300
OPERATIONAL_ALERTS_OFFLINE_AFTER_MINUTES=15
