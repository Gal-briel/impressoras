# Exemplo seguro para rodar o Gabriel usando Supabase/PostgreSQL.
# Nunca commitar senha real.

# URL síncrona usada por rotas legadas com psycopg2.
SYNC_DATABASE_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# URL assíncrona usada pelo SQLAlchemy/asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

OPERATIONAL_ALERTS_OFFLINE_SYNC_ENABLED=true
OPERATIONAL_ALERTS_OFFLINE_SYNC_INTERVAL_SECONDS=300
OPERATIONAL_ALERTS_OFFLINE_AFTER_MINUTES=15
